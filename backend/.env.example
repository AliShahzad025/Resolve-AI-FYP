# URL-encode special characters in the password. Database must already exist.
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/resolveAi
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
