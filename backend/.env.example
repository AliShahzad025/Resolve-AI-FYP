# URL-encode special characters in the password. Database must already exist.
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/resolveAi
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Generate once with: Fernet.generate_key() from cryptography. Do not rotate without re-encrypting stored credentials.
SHOPIFY_ENCRYPTION_KEY=
# Public HTTPS address of this backend, with no trailing slash.
SHOPIFY_APP_BASE_URL=
SHOPIFY_WEBHOOK_BASE_URL=
SHOPIFY_API_VERSION=2026-10
# WhatsApp Cloud API (Meta app dashboard -> App settings -> Basic -> App secret).
WHATSAPP_APP_SECRET=
# Any random string; enter the same value in Meta's webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Optional separate Fernet key for stored WhatsApp tokens (defaults to SHOPIFY_ENCRYPTION_KEY).
WHATSAPP_ENCRYPTION_KEY=

# --- Stage 5: complaint classifier (optional; see requirements-ml.txt) ---
# CLASSIFIER_ENABLED=false     # skip loading the models (faster startup while developing other parts)

# --- Stage 5: policy search (RAG) ---
# Embedding model: run once  ->  python scripts/download_embedding_model.py
# Qdrant runs embedded in backend/qdrant_data by default. To use a Qdrant server instead:
# QDRANT_URL=http://localhost:6333
# RAG_MIN_SCORE=0.825          # minimum similarity for a passage to count as policy evidence

# --- Stage 5: AI draft replies (optional; without it staff still see the matching policy passages) ---
# Provider: groq | xai | openai_compatible | anthropic
DRAFT_PROVIDER=
DRAFT_API_KEY=
# Model name from your provider's model list (Groq: GET https://api.groq.com/openai/v1/models).
# Defaults: groq -> openai/gpt-oss-120b, anthropic -> claude-opus-5-5. Providers rename models; set this if you get a 404.
# xai and openai_compatible need this set.
DRAFT_MODEL=
# Only for openai_compatible, e.g. https://example.com/v1
DRAFT_BASE_URL=
# DRAFT_AUTO=false             # only draft when staff select "Suggest reply"
