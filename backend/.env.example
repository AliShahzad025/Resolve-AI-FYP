# URL-encode special characters in the password. Database must already exist.
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/resolveAi
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Generate once with: Fernet.generate_key() from cryptography. Do not rotate without re-encrypting stored credentials.
SHOPIFY_ENCRYPTION_KEY=
# Public HTTPS address of this backend, with no trailing slash.
SHOPIFY_APP_BASE_URL=
SHOPIFY_WEBHOOK_BASE_URL=
SHOPIFY_API_VERSION=2026-10
